{
  "name": "Agentic Data Assistant",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && docker build -t data-sandbox ./sandbox",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "FastAPI Backend", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit Frontend", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "editor.fontSize": 14
      },
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
