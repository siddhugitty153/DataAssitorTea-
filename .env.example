# ── LLM Provider ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Sandbox Config ──
SANDBOX_IMAGE=data-sandbox
SANDBOX_TIMEOUT=30
SANDBOX_MEM_LIMIT=512m

# ── Agent Config ──
MAX_ITERATIONS=3

# ── Paths ──
DATA_DIR=data
FAISS_DIR=data/faiss_indexes
