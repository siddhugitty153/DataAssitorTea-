# ── Provider Selection ──
# Which backend to use. Options: gemini, ollama, openai
# "ollama" = 100% local + free, no API key needed
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
# Sandbox: "subprocess" for local dev, "docker" for production/Codespace
SANDBOX_PROVIDER=subprocess

# ── Ollama Configuration (local, open-source) ──
# Install: https://ollama.com/download
# Then:    ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Gemini Configuration (cloud, free tier) ──
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── OpenAI Configuration (cloud, paid) ──
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Sandbox Config ──
SANDBOX_TIMEOUT=30
SANDBOX_MEM_LIMIT=512m
SANDBOX_IMAGE=data-sandbox

# ── Agent Config ──
MAX_ITERATIONS=3

# ── Paths ──
DATA_DIR=data
FAISS_DIR=data/faiss_indexes
UPLOADS_DIR=data/uploads
